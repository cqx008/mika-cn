# 本地 release 签名配置(复制为 signing.local.properties 并填本机值)。
# 该文件已加入 .gitignore,不会被提交到公开仓库。
# 构建时通过 -Pmika.keystorePath=... -Pmika.keystorePassword=... 传入,
# 或设置环境变量 MIKA_KEYSTORE_PATH / MIKA_KEYSTORE_PASSWORD / MIKA_KEY_ALIAS / MIKA_KEY_PASSWORD。
mika.keystorePath=
mika.keystorePassword=
mika.keyAlias=mika
mika.keyPassword=
